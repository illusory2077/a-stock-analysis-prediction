# Copy this file to .env and fill in the values locally.
# Never commit .env or real secrets.

# A股主数据源
TUSHARE_TOKEN=

# 全球宏观数据
FRED_API_KEY=

# 全球低频行情（可选）
ALPHAVANTAGE_KEY=

# 新闻搜索和网页研究（可选）
TAVILY_API_KEY=

# 美股实时行情（可选）
POLYGON_API_KEY=

# SEC EDGAR User-Agent（不是密钥，但建议包含应用名和联系邮箱）
SEC_USER_AGENT=AStockAnalysis your_email@example.com

# Runtime settings
APP_ENV=development
LOG_LEVEL=INFO
DATA_TIMEZONE=Asia/Shanghai
REQUEST_TIMEOUT_SECONDS=30
REQUEST_MAX_RETRIES=3

